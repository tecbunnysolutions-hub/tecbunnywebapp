generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model Conversation {
  id                         Int       @id @default(autoincrement())
  sender_number              String    @unique
  last_interaction_timestamp DateTime  @default(now())
  contact_name               String?
  address                    String?
  pincode                    String?
  status                     String    @default("NEW")
  priority                   String    @default("NORMAL")
  tags                       String[]  @default([])
  notes                      String?
  ad_source                  String?
  assigned_to                String?
  department                 String    @default("UNASSIGNED")
  ai_active                  Boolean   @default(true)
  deal_value                 String?
  active_flow                String?
  sla_breach_at              DateTime?
  messages                   Message[]
  orders                     Order[]

  assignedUser User? @relation("AssignedConversations", fields: [assigned_to], references: [id])

  @@map("Conversation")
}

model Organization {
  id         String   @id @default(uuid())
  name       String
  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")
  
  branches   Branch[]
  roles      Role[]
  users      User[]

  @@map("org_organizations")
}

model Branch {
  id              String       @id @default(uuid())
  organization_id String       @map("org_id")
  name            String
  location        String?
  created_at      DateTime     @default(now()) @map("created_at")
  updated_at      DateTime     @updatedAt @map("updated_at")

  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  users           User[]

  @@map("org_branches")
}

model Role {
  id              String       @id @default(uuid())
  organization_id String?      @map("org_id")
  name            String
  description     String?
  is_system_role  Boolean      @default(false) @map("is_system")
  created_at      DateTime     @default(now()) @map("created_at")
  updated_at      DateTime     @updatedAt @map("updated_at")

  organization    Organization? @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  permissions     RolePermission[]
  users           User[]

  @@unique([organization_id, name])
  @@map("sys_roles")
}

model Permission {
  id          String   @id @default(uuid())
  module      String
  action      String
  description String?
  created_at  DateTime @default(now()) @map("created_at")

  roles       RolePermission[]

  @@unique([module, action])
  @@map("sys_permissions")
}

model RolePermission {
  role_id       String
  permission_id String

  role          Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@id([role_id, permission_id])
  @@map("sys_role_permissions")
}

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  name            String
  phone_number    String?
  
  organization_id String?
  branch_id       String?
  role_id         String?

  managed_pincodes Json? // PostgreSQL JSONB array of strings e.g., ["403512", "403513"]
  createdAt       DateTime @default(now())
  
  organization    Organization? @relation(fields: [organization_id], references: [id], onDelete: SetNull)
  branch          Branch?       @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  role            Role?         @relation(fields: [role_id], references: [id], onDelete: SetNull)

  leads            Lead[]

  assigned_conversations Conversation[] @relation("AssignedConversations")
  assigned_tickets       Ticket[]       @relation("AssignedTickets")
  created_campaigns      Campaign[]

  @@map("sys_users_prisma")
}

enum DomainType {
  TECHNICAL_SERVICE
  PRODUCT_SALES
}

model Lead {
  id            String     @id @default(uuid())
  sender_number String?
  domain        DomainType
  sub_category  String // e.g., CCTV, COMPUTERS, NETWORKING, WEB_DEV, HARDWARE_SALES, OTHER
  pincode       String
  address       String?
  status        String     @default("NEW")
  assigned_to   String?
  created_at    DateTime   @default(now()) @map("created_at")
  updated_at    DateTime   @updatedAt @map("updated_at")

  assignedUser User? @relation(fields: [assigned_to], references: [id])

  @@map("sls_leads")
}

model Message {
  id              String    @id @default(uuid())
  message_id      String?   @unique
  sender_number   String
  direction       Direction
  message_content String
  timestamp       DateTime  @default(now())
  status          String    @default("DELIVERED")
  media_url       String?
  media_type      String?

  conversation Conversation @relation(fields: [sender_number], references: [sender_number])

  @@map("Message")
}

model FailedApiCall {
  id         Int      @id @default(autoincrement())
  payload    String
  error      String
  created_at DateTime @default(now())

  @@map("FailedApiCall")
}

enum Direction {
  INBOUND
  OUTBOUND
}

model Template {
  id         String   @id @default(uuid())
  name       String   @unique
  language   String   @default("en")
  content    String
  status     String   @default("APPROVED")
  category   String?  @default("MARKETING")
  provider_name String? @default("infobip")
  provider_template_id String?
  provider_status String? @default("LOCAL_ONLY")
  variable_count Int      @default(0)
  last_synced_at DateTime?
  rejection_reason String?
  created_at DateTime @default(now())
  campaigns  Campaign[]

  @@map("Template")
}

model PageContent {
  key              String   @id
  page_key         String?  @unique
  title            String?
  content          Json?
  data             Json?
  meta_description String?
  meta_keywords    String?
  status           String   @default("draft")
  is_active        Boolean  @default(false)
  updated_at       DateTime @default(now())
  created_at       DateTime @default(now())

  @@map("page_content")
}

model Ticket {
  id            String    @id @default(uuid())
  title         String
  description   String?
  status        String    @default("OPEN")
  priority      String    @default("NORMAL")
  department    String    @default("SUPPORT")
  assigned_to   String?
  sender_number String?
  created_at    DateTime  @default(now()) @map("created_at")
  updated_at    DateTime  @updatedAt @map("updated_at")
  sla_breach_at DateTime? @map("sla_breach_at")

  assignedUser User? @relation("AssignedTickets", fields: [assigned_to], references: [id])

  @@map("sup_tickets")
}

// ----------------------------------------
// E-Commerce Models
// ----------------------------------------
model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Float
  stock       Int      @default(0)
  category    String?
  imageUrl    String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  orderItems OrderItem[]

  @@map("products")
}

model Order {
  id             String      @id @default(uuid())
  customer_phone String
  total_amount   Float
  status         String      @default("PENDING") // PENDING, PAID, DELIVERED, CANCELLED
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt

  items          OrderItem[]
  conversation   Conversation? @relation(fields: [customer_phone], references: [sender_number])

  @@map("orders")
}

model OrderItem {
  id         String  @id @default(uuid())
  order_id   String
  product_id String
  quantity   Int
  price      Float

  order      Order   @relation(fields: [order_id], references: [id])
  product    Product @relation(fields: [product_id], references: [id])

  @@map("order_items")
}

// ----------------------------------------
// Marketing Hub Models
// ----------------------------------------
model Campaign {
  id          String   @id @default(uuid())
  name        String
  status      String   @default("DRAFT") // DRAFT, SCHEDULED, RUNNING, COMPLETED
  template_id String?
  schedule_at DateTime?
  created_by  String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  
  targetAudience CampaignAudience?
  logs           CampaignLog[]

  creator     User?     @relation(fields: [created_by], references: [id])
  template    Template? @relation(fields: [template_id], references: [id])

  @@map("mkt_campaigns")
}

model CampaignAudience {
  id          String   @id @default(uuid())
  campaign_id String   @unique
  criteria    Json     // e.g. { "status": "LEAD", "last_active": "<90days" }
  size        Int      @default(0)

  campaign    Campaign @relation(fields: [campaign_id], references: [id])

  @@map("mkt_audience_members")
}

model CampaignLog {
  id          String   @id @default(uuid())
  campaign_id String
  phone       String
  message_id  String?
  status      String   @default("SENT") // SENT, DELIVERED, READ, REPLIED
  sent_at     DateTime @default(now())

  campaign    Campaign @relation(fields: [campaign_id], references: [id])

  @@map("mkt_campaign_analytics")
}

model Coupon {
  id          String   @id @default(uuid())
  code        String   @unique
  discount    Float
  type        String   @default("PERCENTAGE") // PERCENTAGE, FIXED
  expires_at  DateTime?
  usage_limit Int?
  usage_count Int      @default(0)
  created_at  DateTime @default(now())

  @@map("oms_coupons")
}

// ----------------------------------------
// Marketplace & Seller Management Models
// ----------------------------------------

enum SellerStatus {
  DRAFT
  PENDING_VERIFICATION
  PENDING_APPROVAL
  APPROVED
  SUSPENDED
  REJECTED
  BLOCKED
  INACTIVE
}

enum KYCStatus {
  DRAFT
  SUBMITTED
  PENDING_REVIEW
  VERIFICATION_IN_PROGRESS
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum DocumentType {
  GST_CERTIFICATE
  PAN_CARD
  CANCELLED_CHEQUE
  AADHAAR
  BUSINESS_REGISTRATION
  ADDRESS_PROOF
  AUTHORIZED_SIGNATURE
  LOGO
}

enum SettlementStatus {
  DRAFT
  GENERATED
  UNDER_REVIEW
  APPROVED
  RELEASED
  HELD
}

enum PickupStatus {
  PENDING
  ASSIGNED
  READY_FOR_PICKUP
  PICKED_UP
  DELIVERED_TO_WAREHOUSE
  CANCELLED
}

enum QCStatus {
  PENDING
  PASSED
  PASSED_WITH_REMARKS
  FAILED
}

model Seller {
  id            String       @id @default(uuid())
  business_name String
  owner_name    String
  email         String       @unique
  phone         String       @unique
  password_hash String
  status        SellerStatus @default(DRAFT)
  kyc_status    KYCStatus    @default(DRAFT)
  rating        Float        @default(100.0)
  created_at    DateTime     @default(now())
  updated_at    DateTime     @updatedAt

  profile       SellerProfile?
  business      SellerBusiness?
  addresses     SellerAddress[]
  documents     SellerDocument[]
  bank_account  SellerBankAccount?
  kyc_record    SellerKYC?
  wallet        SellerWallet?
  ledger_items  SellerLedger[]
  settlements   Settlement[]
  pickup_reqs   PickupRequest[]
  audit_logs    MarketplaceAuditLog[]

  @@map("mkt_sellers")
}

model SellerProfile {
  id            String   @id @default(uuid())
  seller_id     String   @unique
  logo_url      String?
  description   String?
  support_email String?
  support_phone String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  seller Seller @relation(fields: [seller_id], references: [id], onDelete: Cascade)

  @@map("mkt_seller_profiles")
}

model SellerBusiness {
  id               String   @id @default(uuid())
  seller_id        String   @unique
  entity_type      String   // PROPRIETORSHIP, PARTNERSHIP, LLP, PVT_LTD, PUBLIC_LTD, OPC
  gst_number       String   @unique
  gst_status       String   @default("UNVERIFIED")
  pan_number       String   @unique
  pan_status       String   @default("UNVERIFIED")
  incorporation_dt DateTime?
  annual_turnover  String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  seller Seller @relation(fields: [seller_id], references: [id], onDelete: Cascade)

  @@map("mkt_seller_business")
}

model SellerAddress {
  id            String   @id @default(uuid())
  seller_id     String
  type          String   // BUSINESS, BILLING, PICKUP
  address_line1 String
  address_line2 String?
  city          String
  state         String
  pincode       String
  landmark      String?
  is_default    Boolean  @default(false)
  created_at    DateTime @default(now())

  seller Seller @relation(fields: [seller_id], references: [id], onDelete: Cascade)

  @@map("mkt_seller_addresses")
}

model SellerDocument {
  id               String       @id @default(uuid())
  seller_id        String
  type             DocumentType
  file_url         String
  status           String       @default("PENDING") // PENDING, VERIFIED, REJECTED
  rejection_reason String?
  verified_at      DateTime?
  created_at       DateTime     @default(now())

  seller Seller @relation(fields: [seller_id], references: [id], onDelete: Cascade)

  @@map("mkt_seller_documents")
}

model SellerBankAccount {
  id                String   @id @default(uuid())
  seller_id         String   @unique
  account_holder    String
  account_number    String
  ifsc_code         String
  bank_name         String
  branch            String?
  penny_drop_status String   @default("PENDING") // PENDING, SUCCESS, FAILED
  is_verified       Boolean  @default(false)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  seller Seller @relation(fields: [seller_id], references: [id], onDelete: Cascade)

  @@map("mkt_seller_bank_accounts")
}

model SellerKYC {
  id               String    @id @default(uuid())
  seller_id        String    @unique
  status           KYCStatus @default(DRAFT)
  submitted_at     DateTime?
  reviewed_by      String?
  reviewed_at      DateTime?
  rejection_reason String?
  notes            String?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  seller Seller @relation(fields: [seller_id], references: [id], onDelete: Cascade)

  @@map("mkt_seller_kyc")
}

model SellerWallet {
  id                String   @id @default(uuid())
  seller_id         String   @unique
  available_balance Float    @default(0.0)
  pending_balance   Float    @default(0.0)
  hold_balance      Float    @default(0.0)
  total_withdrawn   Float    @default(0.0)
  updated_at        DateTime @updatedAt

  seller Seller @relation(fields: [seller_id], references: [id], onDelete: Cascade)

  @@map("mkt_seller_wallets")
}

model SellerLedger {
  id               String   @id @default(uuid())
  seller_id        String
  order_id         String?
  settlement_id    String?
  transaction_type String   // CREDIT, DEBIT
  amount           Float
  description      String
  balance_after    Float
  created_at       DateTime @default(now())

  seller Seller @relation(fields: [seller_id], references: [id], onDelete: Cascade)

  @@map("mkt_seller_ledgers")
}

model Settlement {
  id                 String           @id @default(uuid())
  seller_id          String
  period_start       DateTime
  period_end         DateTime
  gross_amount       Float
  net_settlement     Float
  shipping_deduction Float            @default(0.0)
  commission_fee     Float            @default(0.0)
  tds_deduction      Float            @default(0.0)
  penalty_deduction  Float            @default(0.0)
  gst_adjustment     Float            @default(0.0)
  status             SettlementStatus @default(DRAFT)
  created_at         DateTime         @default(now())
  released_at        DateTime?

  seller Seller           @relation(fields: [seller_id], references: [id], onDelete: Cascade)
  items  SettlementItem[]

  @@map("mkt_settlements")
}

model SettlementItem {
  id                   String     @id @default(uuid())
  settlement_id        String
  order_id             String
  order_item_id        String
  seller_purchase_price Float
  deductions           Float      @default(0.0)
  net_amount           Float

  settlement Settlement @relation(fields: [settlement_id], references: [id], onDelete: Cascade)

  @@map("mkt_settlement_items")
}

model Warehouse {
  id           String   @id @default(uuid())
  name         String
  code         String   @unique
  type         String   @default("PRIMARY") // PRIMARY, REGIONAL, CITY, PICKUP_HUB, RETURN_CENTER
  address      String
  city         String
  state        String
  pincode      String
  capacity     Int      @default(10000)
  manager_name String?
  manager_phone String?
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now())

  pickup_requests PickupRequest[]
  quality_checks  QualityCheck[]

  @@map("wms_warehouses")
}

model PickupRequest {
  id           String       @id @default(uuid())
  order_id     String
  seller_id    String
  warehouse_id String?
  status       PickupStatus @default(PENDING)
  pickup_date  DateTime?
  otp_code     String?
  qr_code      String?
  created_at   DateTime     @default(now())
  updated_at   DateTime     @updatedAt

  seller    Seller     @relation(fields: [seller_id], references: [id], onDelete: Cascade)
  warehouse Warehouse? @relation(fields: [warehouse_id], references: [id], onDelete: SetNull)

  @@map("wms_pickup_requests")
}

model QualityCheck {
  id            String   @id @default(uuid())
  order_item_id String
  warehouse_id  String
  inspector_id  String?
  status        QCStatus @default(PENDING)
  remarks       String?
  checked_at    DateTime @default(now())

  warehouse Warehouse @relation(fields: [warehouse_id], references: [id], onDelete: Cascade)

  @@map("wms_quality_checks")
}

model MarketplaceAuditLog {
  id           String   @id @default(uuid())
  user_id      String
  user_type    String   // SUPERADMIN, ADMIN, SELLER, WAREHOUSE, CUSTOMER
  action       String
  module       String
  before_state Json?
  after_state  Json?
  ip_address   String?
  device_info  String?
  created_at   DateTime @default(now())

  seller Seller? @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("sys_marketplace_audit_logs")
}

