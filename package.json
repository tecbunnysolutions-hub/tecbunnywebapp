{
  "name": "tecbunny-monorepo",
  "packageManager": "npm@11.12.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prebuild": "tsx packages/core/src/environment-validator.ts",
    "build": "turbo run build --filter=./apps/* --filter=./packages/*",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "validate:ux-actions": "node scripts/validate-enterprise-actions.mjs",
    "validate:no-browser-modals": "node scripts/validate-no-browser-modals.mjs",
    "validate:accessibility-contract": "node scripts/validate-accessibility-contract.mjs",
    "validate:product-telemetry": "node scripts/validate-product-telemetry.mjs",
    "validate:performance-budgets": "node scripts/validate-performance-budgets.mjs",
    "validate:visual-baselines": "node scripts/validate-visual-baselines.mjs",
    "validate:launch-evidence": "node scripts/validate-launch-evidence.mjs",
    "validate:theme-contract": "node scripts/validate-theme-contract.mjs",
    "validate:launch-readiness": "node scripts/validate-launch-readiness.mjs",
    "validate:security-gate": "node scripts/validate-security-gate.mjs docs/security/npm-audit-2026-07-26.json docs/security/security-gate-allowlist.json",
    "validate:runtime-readiness": "node scripts/validate-runtime-readiness.mjs runtime-readiness-evidence.json --mode=strict",
    "validate:runtime-readiness:advisory": "node scripts/validate-runtime-readiness.mjs runtime-readiness-evidence.json --mode=advisory",
    "runtime:list-pending-checks": "node scripts/list-runtime-pending-checks.mjs runtime-readiness-evidence.json",
    "validate:runtime-evidence-artifacts": "node scripts/validate-runtime-evidence-artifacts.mjs runtime-readiness-evidence.json",
    "validate:runtime-evidence-completeness": "node scripts/validate-runtime-evidence-completeness.mjs runtime-readiness-evidence.json",
    "runtime:mark-check-pass": "node scripts/mark-runtime-check-pass.mjs runtime-readiness-evidence.json",
    "validate:db-readiness": "node scripts/validate-db-readiness.mjs",
    "validate:infra-observability": "node scripts/validate-infra-observability.mjs",
    "validate:chrome-extension": "node scripts/validate-chrome-extension.mjs",
    "package:chrome-extension": "node scripts/package-chrome-extension.mjs",
    "audit:api": "node scripts/audit-api-surface.mjs",
    "validate:product-ux": "npm run validate:ux-actions && npm run validate:no-browser-modals && npm run validate:accessibility-contract && npm run validate:product-telemetry && npm run validate:performance-budgets && npm run validate:visual-baselines && npm run validate:launch-evidence && npm run validate:theme-contract && npm run validate:launch-readiness && npm run validate:infra-observability && npx tsc --noEmit --pretty false -p apps/public/tsconfig.json && npx tsc --noEmit --pretty false -p apps/mgmt/tsconfig.json && npx tsc --noEmit --pretty false -p apps/waba/tsconfig.json && npx tsc --noEmit --pretty false -p apps/superadmin/tsconfig.json",
    "clean": "turbo run clean",
    "prepare": "husky",
    "postinstall": "npm run db:generate",
    "db:generate": "npx prisma generate --schema=./packages/types/prisma/schema.prisma",
    "reset-db": "npm run reset-db --workspace=@tecbunny/infra",
    "test": "turbo run test"
  },
  "devDependencies": {
    "eslint": "^9.39.1",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "pptxgenjs": "^4.0.1",
    "tsx": "^4.23.0",
    "turbo": "2.10.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.62.1"
  },
  "overrides": {
    "@prisma/dev": {
      "@hono/node-server": "1.19.13",
      "valibot": "1.4.2"
    },
    "postcss": "8.5.19",
    "fast-uri": "4.1.0",
    "valibot": "1.4.2",
    "sharp": "0.35.3",
    "ajv": {
      "fast-uri": "4.1.0"
    },
    "@storybook/mcp": {
      "valibot": "1.4.2"
    },
    "tmcp": {
      "valibot": "1.4.2"
    },
    "next@16.2.10": {
      "postcss": "8.5.19",
      "sharp": "0.35.3"
    }
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "eslint --fix"
    ]
  }
}
