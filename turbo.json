{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "ANALYZE",
    "CASHFREE_ENV",
    "CASHFREE_PROD_APP_ID",
    "CASHFREE_PROD_SECRET_KEY",
    "DATABASE_URL",
    "DIRECT_URL",
    "DOCKER_BUILD",
    "GEMINI_API_KEY",
    "HUBSPOT_ACCESS_TOKEN",
    "INFOBIP_API_KEY",
    "INFOBIP_BASE_URL",
    "INFOBIP_HMAC_SECRET",
    "INFOBIP_WHATSAPP_FROM",
    "INFOBIP_WHATSAPP_TEMPLATE_LANGUAGE",
    "INFOBIP_WHATSAPP_TEMPLATE_NAME",
    "META_ACCESS_TOKEN",
    "META_GRAPH_API_VERSION",
    "META_PHONE_NUMBER_ID",
    "META_WABA_ID",
    "META_WHATSAPP_VERIFY_TOKEN",
    "NEXT_IMAGE_ALLOWED_HOSTS",
    "NEXT_OUTPUT_MODE",
    "NEXT_PUBLIC_*",
    "NODE_ENV",
    "OPENAI_API_KEY",
    "OTP_SECRET_PEPPER",
    "PAYU_CLIENT_ID",
    "PAYU_CLIENT_SECRET",
    "PAYU_ENVIRONMENT",
    "PAYU_MERCHANT_KEY",
    "PAYU_MERCHANT_SALT",
    "REDIS_URL",
    "SARVAM_API_KEY",
    "SESSION_SECRET",
    "SMTP_FROM",
    "SMTP_HOST",
    "SMTP_PASS",
    "SMTP_PORT",
    "SMTP_SECURE",
    "SMTP_USER",
    "SUPABASE_BUCKET_NAME",
    "SUPABASE_DB_PASSWORD",
    "SUPABASE_JWKS_URL",
    "SUPABASE_S3_ACCESS_KEY",
    "SUPABASE_S3_REGION",
    "SUPABASE_S3_SECRET_KEY",
    "SUPABASE_S3_URL",
    "SUPABASE_SECRET_KEY",
    "SUPERADMIN_PASSWORD",
    "SUPERADMIN_PASSWORD_HASH",
    "SUPERADMIN_SESSION_SECRET",
    "SUPERADMIN_USER_ID",
    "SYSTEM_NUMBER",
    "TOTP_SECRET_ENCRYPTION_KEY",
    "TURNSTILE_SECRET_KEY",
    "VERCEL_ENV",
    "WHATSAPP_WEBHOOK_VERIFY_TOKEN"
  ],
  "tasks": {
    "//#build": {
      "dependsOn": [],
      "outputs": []
    },
    "build": {
      "dependsOn": [
        "^build",
        "lint"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        "build/**"
      ]
    },
    "@tecbunny/config#build": {
      "dependsOn": [
        "^build",
        "lint"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": []
    },
    "@tecbunny/rpc#build": {
      "dependsOn": [
        "^build",
        "lint"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": []
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": [],
      "cache": false
    },
    "clean": {
      "cache": false
    }
  },
  "globalDependencies": [
    "tsconfig.json",
    "eslint.config.mjs",
    ".env*"
  ]
}
