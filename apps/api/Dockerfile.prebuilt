# Next compilation and Linux dependency installation happen locally.
# On x64-v1 hosts, also apply the verified native compatibility overlay described
# in docs/production-local-release-2026-10-29.md before running this candidate.
FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production HOSTNAME=0.0.0.0 PORT=3001 NEXT_TELEMETRY_DISABLED=1
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs
COPY --chown=nextjs:nodejs runtime/ ./
WORKDIR /app/apps/api
USER nextjs
EXPOSE 3001
CMD ["node", "../../node_modules/next/dist/bin/next", "start", "--hostname", "0.0.0.0"]
