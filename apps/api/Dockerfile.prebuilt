# Compilation and Linux runtime installation happen locally. The VPS only copies files.
FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production HOSTNAME=0.0.0.0 PORT=3001 NEXT_TELEMETRY_DISABLED=1
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs
COPY --chown=nextjs:nodejs runtime/ ./
USER nextjs
EXPOSE 3001
CMD ["node", "node_modules/next/dist/bin/next", "start", "apps/api", "--hostname", "0.0.0.0"]
