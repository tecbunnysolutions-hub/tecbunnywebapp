{
  "name": "tecbunny-store",
  "version": "1.0.0",
  "description": "TecBunny E-commerce Platform with Order Management",
  "homepage": "https://tecbunny.com",
  "private": true,
  "scripts": {
    "dev": "next dev -p 9003",
    "build": "next build --webpack && node ../../scripts/validate-content-placeholders.mjs",
    "build:prod": "npm run typecheck && npm run lint && npm run build",
    "build:prod-full": "npm run build:prod",
    "build:analyze": "cross-env ANALYZE=true next build --webpack",
    "start": "next start",
    "start:prod": "next start",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "audit:fix": "npm audit fix",
    "deps:check": "npm outdated",
    "deps:update": "npm update --save",
    "test": "vitest run --passWithNoTests",
    "lint:check": "npm run lint",
    "lint": "eslint src"
  },
  "dependencies": {
    "@cashfreepayments/cashfree-js": "^1.0.7",
    "@hookform/resolvers": "5.4.0",
    "@supabase/supabase-js": "^2.110.7",
    "@tecbunny/api-client": "*",
    "@tecbunny/config": "*",
    "@tecbunny/contracts": "*",
    "@tecbunny/core": "*",
    "@tecbunny/database": "*",
    "@tecbunny/rpc": "*",
    "@tecbunny/ui": "*",
    "@vercel/analytics": "^2.0.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^0.468.0",
    "next": "^16.3.4",
    "qrcode": "1.5.4",
    "react": "19.2.7",
    "react-confetti": "^6.4.0",
    "react-dom": "19.2.7",
    "react-hook-form": "7.82.0",
    "react-hot-toast": "2.6.0",
    "sharp": "^0.35.4",
    "tailwindcss-animate": "1.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/aspect-ratio": "0.4.2",
    "@tailwindcss/cli": "4.3.3",
    "@tailwindcss/forms": "0.5.11",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@types/node": "^26.1.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19",
    "autoprefixer": "10.5.4",
    "cross-env": "10.1.0",
    "dotenv": "^17.4.2",
    "postcss": "8.5.28",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "^4.3.3",
    "@tailwindcss/oxide-linux-x64-musl": "^4.3.3",
    "@tailwindcss/oxide-win32-x64-msvc": "^4.3.3",
    "lightningcss-linux-x64-gnu": "^1.32.0",
    "lightningcss-linux-x64-musl": "^1.32.0",
    "lightningcss-win32-x64-msvc": "^1.32.0"
  },
  "vitest": {
    "globals": true,
    "environment": "jsdom",
    "coverage": {
      "provider": "c8"
    }
  },
  "engines": {
    "node": "20.x || 22.x || 24.x",
    "npm": ">=10.2.0"
  }
}
